{
  "name": "ets",
  "aliases": ["arkts"],
  "fileTypes": ["ets"],
  "version": "0.0.1",
  "scopeName": "source.ets",
  "foldingStartMarker": "\\{\\s*$",
  "foldingStopMarker": "^\\s*\\}",
  "patterns": [
    {
      "name": "meta.preprocessor.script.ets",
      "match": "^(#!.*)$"
    },
    {
      "name": "meta.declaration.ets",
      "begin": "^\\s*\\b(library|import|part of|part|export)\\b",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.import.ets"
        }
      },
      "end": "(;|$)",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.ets"
        }
      },
      "patterns": [
        {
          "name": "keyword.other.import.ets",
          "match": "\\b(as|show|hide|from)\\b"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#comments"
        },
        {
          "name": "keyword.control.ets",
          "match": "\\b(if)\\b"
        }
      ]
    },
    {
      "include": "#comments"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants-and-special-vars"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#strings"
    }
  ],

  "repository": {
    "dartdoc": {
      "patterns": [
        {
          "match": "(\\[.*?\\])",
          "captures": {
            "0": {
              "name": "variable.name.source.ets"
            }
          }
        },
        {
          "match": "^ {4,}(?![ \\*]).*",
          "captures": {
            "0": {
              "name": "variable.name.source.ets"
            }
          }
        },
        {
          "contentName": "variable.other.source.ets",
          "begin": "```.*?$",
          "end": "```"
        },
        {
          "match": "(`[^`]+?`)",
          "captures": {
            "0": {
              "name": "variable.other.source.ets"
            }
          }
        },
        {
          "match": "(\\* ((    ).*))$",
          "captures": {
            "2": {
              "name": "variable.other.source.ets"
            }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.empty.ets",
          "match": "/\\*\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.ets"
            }
          }
        },
        {
          "include": "#comments-doc-oldschool"
        },
        {
          "include": "#comments-doc"
        },
        {
          "include": "#comments-inline"
        }
      ]
    },
    "comments-doc-oldschool": {
      "patterns": [
        {
          "name": "comment.block.documentation.ets",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments-doc-oldschool"
            },
            {
              "include": "#comments-block"
            },
            {
              "include": "#dartdoc"
            }
          ]
        }
      ]
    },
    "comments-doc": {
      "patterns": [
        {
          "name": "comment.block.documentation.ets",
          "begin": "///",
          "while": "^\\s*///",
          "patterns": [
            {
              "include": "#dartdoc"
            }
          ]
        }
      ]
    },
    "comments-inline": {
      "patterns": [
        {
          "include": "#comments-block"
        },
        {
          "match": "((//).*)$",
          "captures": {
            "1": {
              "name": "comment.line.double-slash.ets"
            }
          }
        }
      ]
    },
    "comments-block": {
      "patterns": [
        {
          "name": "comment.block.ets",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#comments-block"
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.ets",
          "match": "@[a-zA-Z]+"
        }
      ]
    },
    "constants-and-special-vars": {
      "patterns": [
        {
          "name": "constant.language.ets",
          "match": "(?<!\\$)\\b(true|false|null)\\b(?!\\$)"
        },
        {
          "name": "variable.language.ets",
          "match": "(?<!\\$)\\b(this|super)\\b(?!\\$)"
        },
        {
          "name": "constant.numeric.ets",
          "match": "(?<!\\$)\\b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)\\b(?!\\$)"
        },
        {
          "include": "#class-identifier"
        },
        {
          "include": "#function-identifier"
        }
      ]
    },
    "class-identifier": {
      "patterns": [
        {
          "match": "(?<!\\$)\\b(bool|num|int|double|dynamic)\\b(?!\\$)",
          "name": "support.class.ets"
        },
        {
          "match": "(?<!\\$)\\bvoid\\b(?!\\$)",
          "name": "storage.type.primitive.ets"
        },
        {
          "begin": "(?<![a-zA-Z0-9_$])([_$]*[A-Z][a-zA-Z0-9_$]*)\\b",
          "end": "(?!<)",
          "beginCaptures": {
            "1": {
              "name": "support.class.ets"
            }
          },
          "patterns": [
            {
              "include": "#type-args"
            }
          ]
        }
      ]
    },
    "function-identifier": {
      "patterns": [
        {
          "match": "([_$]*[a-z][a-zA-Z0-9_$]*)(<(?:[a-zA-Z0-9_$<>?]|,\\s*|\\s+extends\\s+)+>)?[!?]?\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.ets"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type-args"
                }
              ]
            }
          }
        }
      ]
    },
    "type-args": {
      "begin": "(<)",
      "end": "(>)",
      "beginCaptures": {
        "1": {
          "name": "other.source.ets"
        }
      },
      "endCaptures": {
        "1": {
          "name": "other.source.ets"
        }
      },
      "patterns": [
        {
          "include": "#class-identifier"
        },
        {
          "match": ","
        },
        {
          "name": "keyword.declaration.ets",
          "match": "extends"
        },
        {
          "include": "#comments"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.cast.ets",
          "match": "(?<!\\$)\\bas\\b(?!\\$)"
        },
        {
          "name": "keyword.control.catch-exception.ets",
          "match": "(?<!\\$)\\b(try|on|catch|finally|throw|rethrow)\\b(?!\\$)"
        },
        {
          "name": "keyword.control.ets",
          "match": "(?<!\\$)\\b(break|case|continue|default|do|else|for|if|in|switch|while|when)\\b(?!\\$)"
        },
        {
          "name": "keyword.control.ets",
          "match": "(?<!\\$)\\b(sync(\\*)?|async(\\*)?|await|yield(\\*)?)\\b(?!\\$)"
        },
        {
          "name": "keyword.control.ets",
          "match": "(?<!\\$)\\bassert\\b(?!\\$)"
        },
        {
          "name": "keyword.control.new.ets",
          "match": "(?<!\\$)\\b(new)\\b(?!\\$)"
        },
        {
          "name": "keyword.control.return.ets",
          "match": "(?<!\\$)\\b(return)\\b(?!\\$)"
        },
        {
          "name": "keyword.declaration.ets",
          "match": "(?<!\\$)\\b(abstract|sealed|base|interface|class|struct|enum|extends|extension type|extension|external|factory|implements|get(?![(<])|mixin|native|operator|set(?![(<])|typedef|with|covariant)\\b(?!\\$)"
        },
        {
          "name": "storage.modifier.ets",
          "match": "(?<!\\$)\\b(static|final|const|required|late|private|public|protected)\\b(?!\\$)"
        },
        {
          "name": "storage.type.primitive.ets",
          "match": "(?<!\\$)\\b(?:void|var)\\b(?!\\$)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.ets",
          "match": "(?<!\\$)\\b(is\\!?)\\b(?!\\$)"
        },
        {
          "name": "keyword.operator.ternary.ets",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.bitwise.ets",
          "match": "(<<|>>>?|~|\\^|\\||&)"
        },
        {
          "name": "keyword.operator.assignment.bitwise.ets",
          "match": "((&|\\^|\\||<<|>>>?)=)"
        },
        {
          "name": "keyword.operator.closure.ets",
          "match": "(=>)"
        },
        {
          "name": "keyword.operator.comparison.ets",
          "match": "(==|!=|<=?|>=?)"
        },
        {
          "name": "keyword.operator.assignment.arithmetic.ets",
          "match": "(([+*/%-]|\\~)=)"
        },
        {
          "name": "keyword.operator.assignment.ets",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.increment-decrement.ets",
          "match": "(\\-\\-|\\+\\+)"
        },
        {
          "name": "keyword.operator.arithmetic.ets",
          "match": "(\\-|\\+|\\*|\\/|\\~\\/|%)"
        },
        {
          "name": "keyword.operator.logical.ets",
          "match": "(!|&&|\\|\\|)"
        }
      ]
    },
    "string-interp": {
      "patterns": [
        {
          "name": "string.interpolated.expression.ets",
          "match": "\\$([a-zA-Z0-9_]+)",
          "captures": {
            "1": {
              "name": "variable.parameter.ets"
            }
          }
        },
        {
          "name": "string.interpolated.expression.ets",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#constants-and-special-vars"
            },
            {
              "include": "#strings"
            },
            {
              "name": "variable.parameter.ets",
              "match": "[a-zA-Z0-9_]+"
            }
          ]
        },
        {
          "name": "constant.character.escape.ets",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.triple.double.ets",
          "begin": "(?<!r)\"\"\"",
          "end": "\"\"\"(?!\")",
          "patterns": [
            {
              "include": "#string-interp"
            }
          ]
        },
        {
          "name": "string.interpolated.triple.single.ets",
          "begin": "(?<!r)'''",
          "end": "'''(?!')",
          "patterns": [
            {
              "include": "#string-interp"
            }
          ]
        },
        {
          "name": "string.quoted.triple.double.ets",
          "begin": "r\"\"\"",
          "end": "\"\"\"(?!\")"
        },
        {
          "name": "string.quoted.triple.single.ets",
          "begin": "r'''",
          "end": "'''(?!')"
        },
        {
          "name": "string.interpolated.double.ets",
          "begin": "(?<!\\|r)\"",
          "end": "\"",
          "patterns": [
            {
              "name": "invalid.string.newline",
              "match": "\\n"
            },
            {
              "include": "#string-interp"
            }
          ]
        },
        {
          "name": "string.quoted.double.ets",
          "begin": "r\"",
          "end": "\"",
          "patterns": [
            {
              "name": "invalid.string.newline",
              "match": "\\n"
            }
          ]
        },
        {
          "name": "string.interpolated.single.ets",
          "begin": "(?<!\\|r)'",
          "end": "'",
          "patterns": [
            {
              "name": "invalid.string.newline",
              "match": "\\n"
            },
            {
              "include": "#string-interp"
            }
          ]
        },
        {
          "name": "string.quoted.single.ets",
          "begin": "r'",
          "end": "'",
          "patterns": [
            {
              "name": "invalid.string.newline",
              "match": "\\n"
            }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.comma.ets",
          "match": ","
        },
        {
          "name": "punctuation.terminator.ets",
          "match": ";"
        },
        {
          "name": "punctuation.dot.ets",
          "match": "\\."
        }
      ]
    }
  }
}