{
  "Entry 页面": {
    "prefix": "entry",
    "body": [
      "@Entry",
      "@Component",
      "struct ${1:${TM_FILENAME_BASE}} {",
      "\t@State ${2:message}: ${3:string} = ${4:'Hello World'};",
      "",
      "\tbuild() {",
      "\t\t${5:Column}() {",
      "\t\t\t$0",
      "\t\t}",
      "\t\t.width('100%')",
      "\t\t.height('100%')",
      "\t}",
      "}"
    ],
    "description": "@Entry @Component 页面入口组件"
  },
  "Component 自定义组件": {
    "prefix": "component",
    "body": [
      "@Component",
      "${1|export ,|}struct ${2:${TM_FILENAME_BASE}} {",
      "\tbuild() {",
      "\t\t${3:Column}() {",
      "\t\t\t$0",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "@Component 自定义组件（状态管理 V1）"
  },
  "ComponentV2 自定义组件": {
    "prefix": "componentv2",
    "body": [
      "@ComponentV2",
      "${1|export ,|}struct ${2:${TM_FILENAME_BASE}} {",
      "\t@Param ${3:title}: ${4:string} = ${5:''};",
      "\t@Local ${6:count}: ${7:number} = ${8:0};",
      "",
      "\tbuild() {",
      "\t\t${9:Column}() {",
      "\t\t\t$0",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "@ComponentV2 自定义组件（状态管理 V2）"
  },
  "CustomDialog 自定义弹窗": {
    "prefix": "customdialog",
    "body": [
      "@CustomDialog",
      "struct ${1:MyDialog} {",
      "\tcontroller: CustomDialogController;",
      "",
      "\tbuild() {",
      "\t\tColumn() {",
      "\t\t\t$0",
      "\t\t\tButton('关闭').onClick(() => {",
      "\t\t\t\tthis.controller.close();",
      "\t\t\t})",
      "\t\t}",
      "\t\t.padding(20)",
      "\t}",
      "}"
    ],
    "description": "@CustomDialog 自定义弹窗组件"
  },
  "CustomDialogController": {
    "prefix": "dialogcontroller",
    "body": [
      "${1:dialogController}: CustomDialogController = new CustomDialogController({",
      "\tbuilder: ${2:MyDialog}(),",
      "\tautoCancel: ${3:true},",
      "});"
    ],
    "description": "声明 CustomDialogController"
  },
