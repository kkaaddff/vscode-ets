  "@Monitor": {
    "prefix": "monitor",
    "body": [
      "@Monitor('${1:path}')",
      "${2:onChange}(monitor: IMonitor) {",
      "\tmonitor.dirty.forEach((path: string) => {",
      "\t\tconsole.info(`\\${path}: \\${monitor.value(path)?.before} -> \\${monitor.value(path)?.now}`);",
      "\t});",
      "}"
    ],
    "description": "V2 状态变量监听"
  },
  "@Computed": {
    "prefix": "computed",
    "body": [
